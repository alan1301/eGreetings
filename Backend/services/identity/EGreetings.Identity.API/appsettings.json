{
  "ServiceName": "identity-service",
  "ConnectionStrings": {
    "Default": "see environment variable CONNECTIONSTRINGS__DEFAULT"
  },
  "Jwt": {
    "Issuer": "EGreetings",
    "Audience": "EGreetings-Users",
    "SecretKey": "see environment variable JWT__SECRETKEY",
    "ExpiryMinutes": 60
  },
  "RabbitMQ": {
    "Host": "localhost",
    "Username": "guest",
    "Password": "see environment variable RABBITMQ__PASSWORD"
  },
  "InternalApi": {
    "Secret": "see environment variable INTERNALAPI__SECRET"
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": "Information",
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/identity-service-.txt",
          "rollingInterval": "Day",
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName" ]
  }
}
