{
  "ServiceName": "admin-service",
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console" ],
    "MinimumLevel": "Information",
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Message:lj} {Properties:j}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ]
  },
  "ConnectionStrings": {
    "Default": "see environment variable CONNECTIONSTRINGS__DEFAULT"
  },
  "RabbitMQ": {
    "Host": "localhost",
    "Username": "guest",
    "Password": "see environment variable RABBITMQ__PASSWORD"
  },
  "InternalServices": {
    "IdentityService": "http://localhost:5001",
    "GreetingService": "http://localhost:5002",
    "SubscriptionService": "http://localhost:5003",
    "FeedbackService": "http://localhost:5004"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
