{
  "ServiceName": "notification-service",
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console" ],
    "MinimumLevel": "Information",
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Message:lj} {Properties:j}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ]
  },
  "ConnectionStrings": {
    "Default": "see environment variable CONNECTIONSTRINGS__DEFAULT"
  },
  "RabbitMQ": {
    "Host": "localhost",
    "Username": "guest",
    "Password": "see environment variable RABBITMQ__PASSWORD"
  },
  "Email": {
    "Host": "smtp.example.com",
    "Port": "587",
    "Username": "no-reply@egreetings.vn",
    "Password": "see environment variable EMAIL__PASSWORD",
    "SenderName": "E-Greetings",
    "SenderEmail": "no-reply@egreetings.vn"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
