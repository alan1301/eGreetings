# Copy this file to .env and fill in your values
# cp .env.example .env

# SQL Server SA password (must meet complexity: uppercase, lowercase, digit, special char, min 8 chars)
SA_PASSWORD=YourStrong@Passw0rd

# JWT signing secret key (min 32 chars recommended)
JWT_SECRET_KEY=SuperSecretKey_EGreetings_Change_In_Production_Min32Chars!

# Internal API shared secret (used for service-to-service calls)
INTERNAL_API_SECRET=InternalSecret_EGreetings_2024

# RabbitMQ credentials (default: guest/guest — change in production)
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest
