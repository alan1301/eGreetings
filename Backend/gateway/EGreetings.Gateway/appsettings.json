{
  "Jwt": {
    "Issuer": "EGreetings",
    "Audience": "EGreetings-Users",
    "SecretKey": "see environment variable JWT__SECRETKEY"
  },
  "ReverseProxy": {
    "Routes": {
      "identity-route": {
        "ClusterId": "identity-cluster",
        "Match": { "Path": "/api/auth/{**catch-all}" }
      },
      "identity-admin-users-route": {
        "ClusterId": "identity-cluster",
        "Match": { "Path": "/api/admin/users/{**catch-all}" }
      },
      "greeting-templates-route": {
        "ClusterId": "greeting-cluster",
        "Match": { "Path": "/api/templates/{**catch-all}" }
      },
      "greeting-categories-route": {
        "ClusterId": "greeting-cluster",
        "Match": { "Path": "/api/categories/{**catch-all}" }
      },
      "greeting-route": {
        "ClusterId": "greeting-cluster",
        "Match": { "Path": "/api/greetings/{**catch-all}" }
      },
      "subscription-route": {
        "ClusterId": "subscription-cluster",
        "Match": { "Path": "/api/subscriptions/{**catch-all}" }
      },
      "user-route": {
        "ClusterId": "user-cluster",
        "Match": { "Path": "/api/users/{**catch-all}" }
      },
      "admin-route": {
        "ClusterId": "admin-cluster",
        "Match": { "Path": "/api/admin/{**catch-all}" }
      },
      "feedback-route": {
        "ClusterId": "feedback-cluster",
        "Match": { "Path": "/api/feedback/{**catch-all}" }
      }
    },
    "Clusters": {
      "identity-cluster": {
        "Destinations": {
          "identity": {
            "Address": "http://identity-service:8080"
          }
        }
      },
      "greeting-cluster": {
        "Destinations": {
          "greeting": {
            "Address": "http://greeting-service:8080"
          }
        }
      },
      "subscription-cluster": {
        "Destinations": {
          "subscription": {
            "Address": "http://subscription-service:8080"
          }
        }
      },
      "user-cluster": {
        "Destinations": {
          "user": {
            "Address": "http://user-service:8080"
          }
        }
      },
      "admin-cluster": {
        "Destinations": {
          "admin": {
            "Address": "http://admin-service:8080"
          }
        }
      },
      "feedback-cluster": {
        "Destinations": {
          "feedback": {
            "Address": "http://feedback-service:8080"
          }
        }
      }
    }
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console" ],
    "MinimumLevel": "Information",
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Message:lj} {Properties:j}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
